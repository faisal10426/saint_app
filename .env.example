# Product shown by this build: com.paintasaint.lifetimeunlock ($4.99 one-time unlock)
# In the native release, create this same product ID in App Store Connect and Google Play Console.

# DEVELOPMENT ONLY. When true, the $4.99 purchase button simulates a successful
# non-consumable purchase so the premium flow can be tested in a browser.
VITE_DEMO_IAP=false

# Optional production endpoint. It must receive { productId, receiptData } and
# return { hasEntitlement: true } only after server-side receipt verification.
VITE_ENTITLEMENT_VERIFY_URL=
